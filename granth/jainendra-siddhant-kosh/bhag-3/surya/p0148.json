{"blocks": [{"polygon": [[74.636, 85.31], [154.036, 85.31], [154.036, 125.72], [74.636, 125.72]], "confidence": 0.9832803727542067, "label": "PageHeader", "raw_label": "Page-Header", "reading_order": 0, "html": "प्रमाण", "skipped": false, "error": false, "bbox": [74.636, 85.31, 154.036, 125.72]}, {"polygon": [[754.3, 78.575], [820.996, 78.575], [820.996, 121.23], [754.3, 121.23]], "confidence": 0.9832803727542067, "label": "PageHeader", "raw_label": "Page-Header", "reading_order": 1, "html": "१४१", "skipped": false, "error": false, "bbox": [754.3, 78.575, 820.996, 121.23]}, {"polygon": [[1294.22, 74.08500000000001], [1513.364, 74.08500000000001], [1513.364, 118.985], [1294.22, 118.985]], "confidence": 0.9832803727542067, "label": "PageHeader", "raw_label": "Page-Header", "reading_order": 2, "html": "२ प्रमाण निर्देश", "skipped": false, "error": false, "bbox": [1294.22, 74.08500000000001, 1513.364, 118.985]}, {"polygon": [[111.16000000000001, 157.15], [743.1840000000001, 157.15], [743.1840000000001, 877.7950000000001], [111.16000000000001, 877.7950000000001]], "confidence": 0.9832803727542067, "label": "Table", "raw_label": "Table", "reading_order": 3, "html": "<table><tr><td>६</td><td>प्रमाणको लक्ष्य और प्रमाकरणको लक्षण माननेमे दोष ।</td></tr><tr><td>७</td><td>प्रमाण और प्रमेयमें कथचित् भेदाभेद ।</td></tr><tr><td>८</td><td>प्रमाण व उसके फलोंमें कथचित् भेदाभेद ।</td></tr><tr><td>५</td><td><b>गणनादि प्रमाण निर्देश</b></td></tr><tr><td>१</td><td>प्रमाणके भेद—१ गणनाको अपेक्षा; २ निक्षेपकी अपेक्षा ।</td></tr><tr><td>*</td><td>अन्य अनेकों भेद—अंगुल, संख्यात, असंख्यात, अनंत, सागर, पल्य आदि प्रमाण ।<br/>—दे० वह वह नाम ।</td></tr><tr><td>२</td><td>गणना प्रमाणके भेदोंके लक्षण ।</td></tr><tr><td>३</td><td>निक्षेप रूप प्रमाणोंके लक्षण ।</td></tr><tr><td>*</td><td>गणना प्रमाण सम्बन्धित विषय । —दे० गणित ।</td></tr></table>", "skipped": false, "error": false, "bbox": [111.16000000000001, 157.15, 743.1840000000001, 877.7950000000001]}, {"polygon": [[106.396, 945.145], [319.18800000000005, 945.145], [319.18800000000005, 992.29], [106.396, 992.29]], "confidence": 0.9832803727542067, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 4, "html": "<h2>१. भेद व लक्षण</h2>", "skipped": false, "error": false, "bbox": [106.396, 945.145, 319.18800000000005, 992.29]}, {"polygon": [[111.16000000000001, 1008.005], [439.87600000000003, 1008.005], [439.87600000000003, 1048.415], [111.16000000000001, 1048.415]], "confidence": 0.9832803727542067, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 5, "html": "<h3>१ प्रमाण सामान्यका लक्षण</h3>", "skipped": false, "error": false, "bbox": [111.16000000000001, 1008.005, 439.87600000000003, 1048.415]}, {"polygon": [[106.396, 1061.885], [268.372, 1061.885], [268.372, 1104.54], [106.396, 1104.54]], "confidence": 0.9832803727542067, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 6, "html": "<h4>१. निरुक्ति अर्थ</h4>", "skipped": false, "error": false, "bbox": [106.396, 1061.885, 268.372, 1104.54]}, {"polygon": [[80.988, 1113.52], [757.476, 1113.52], [757.476, 1261.69], [80.988, 1261.69]], "confidence": 0.9832803727542067, "label": "Text", "raw_label": "Text", "reading_order": 7, "html": "<p>स सि /१/१०/१८/२ प्रमिणोति प्रमीयतेऽनेन प्रमितिमात्र वा प्रमाणम् । जो अच्छी तरह मान करता है, जिसके द्वारा अच्छी तरह मान किया जाता है या प्रमितिमात्र प्रमाण है । ( रा.वा./१/१०/१/४६/१३ )</p>", "skipped": false, "error": false, "bbox": [80.988, 1113.52, 757.476, 1261.69]}, {"polygon": [[80.988, 1257.2], [757.476, 1257.2], [757.476, 1371.695], [80.988, 1371.695]], "confidence": 0.9832803727542067, "label": "Text", "raw_label": "Text", "reading_order": 8, "html": "<p>क.पा /१/१,१/३२७/३७/६ प्रमीयतेऽनेनेति प्रमाणम् । = जिसके द्वारा पदार्थ जाना जाता है उसे प्रमाण कहते है । ( आ.प./६ ) (स.म./२८/३०७/१८) ( न्या.दी /१/३१०/११ )</p>", "skipped": false, "error": false, "bbox": [80.988, 1257.2, 757.476, 1371.695]}, {"polygon": [[106.396, 1378.43], [242.964, 1378.43], [242.964, 1418.84], [106.396, 1418.84]], "confidence": 0.9832803727542067, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 9, "html": "<h4>२. अन्य अर्थ</h4>", "skipped": false, "error": false, "bbox": [106.396, 1378.43, 242.964, 1418.84]}, {"polygon": [[80.988, 1427.82], [757.476, 1427.82], [757.476, 1504.15], [80.988, 1504.15]], "confidence": 0.9832803727542067, "label": "Text", "raw_label": "Text", "reading_order": 10, "html": "<p>१. आहारका एक दोष—दे०आहार /II/४ । २. वसतिकाका एक दोष—दे० वसतिका; ३. Measure (ज प./प्र. १०७)</p>", "skipped": false, "error": false, "bbox": [80.988, 1427.82, 757.476, 1504.15]}, {"polygon": [[106.396, 1522.1100000000001], [304.896, 1522.1100000000001], [304.896, 1569.2549999999999], [106.396, 1569.2549999999999]], "confidence": 0.9832803727542067, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 11, "html": "<h3>२. प्रमाणके भेद</h3>", "skipped": false, "error": false, "bbox": [106.396, 1522.1100000000001, 304.896, 1569.2549999999999]}, {"polygon": [[80.988, 1578.235], [760.6519999999999, 1578.235], [760.6519999999999, 1870.0849999999998], [80.988, 1870.0849999999998]], "confidence": 0.9832803727542067, "label": "Text", "raw_label": "Text", "reading_order": 12, "html": "<p>त.सू /१/१०-१२ भावार्थ—प्रमाण दो प्रकारका है—प्रत्यक्ष व परोक्ष(ध.६/४.१.४५/१४२/६) (न च वृ /१७०) (प.सु./१/१०,२/१) (ज.प./१३/४७) (गो.जो./सू व.जो प्र /२६६/६४८) (स सा./आ./१३/क.८ की टीका) (स.म./३८/३३१/५) (स्या.म./२८/३०७/१६) (न्या.दी./२/३१/२३)</p><p>स.सि./१/६/२०/३ तत्र प्रमाणं द्विविधं स्वार्थ परार्थ च । =प्रमाणके दो भेद है—स्वार्थ और परार्थ । (रा.वा /१/६/४/३३/११)</p><p>न्या.सू /सू /१/१/३/६ प्रत्यक्षानुमानोपमानशब्दा. प्रमाणानि । =प्रत्यक्ष, अनुमान, उपमान और शब्दके भेदसे प्रमाण चार प्रकारका है ।</p>", "skipped": false, "error": false, "bbox": [80.988, 1578.235, 760.6519999999999, 1870.0849999999998]}, {"polygon": [[111.16000000000001, 1892.5349999999999], [419.232, 1892.5349999999999], [419.232, 1935.19], [111.16000000000001, 1935.19]], "confidence": 0.9832803727542067, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 13, "html": "<h3>३. प्रमाणके भेदोंके लक्षण</h3>", "skipped": false, "error": false, "bbox": [111.16000000000001, 1892.5349999999999, 419.232, 1935.19]}, {"polygon": [[80.988, 1941.925], [762.24, 1941.925], [762.24, 2094.585], [80.988, 2094.585]], "confidence": 0.9832803727542067, "label": "Text", "raw_label": "Text", "reading_order": 14, "html": "<p>स.सि./१/६/२०/४ ज्ञानात्मकं स्वार्थं वचनात्मक परार्थम् । = ज्ञानात्मक प्रमाणको स्वार्थ प्रमाण कहते है और वचनात्मक प्रमाण परार्थ प्रमाण कहलाता है । (रा.वा./१/६/४/३३/११) (सि.वि /सू /२/४/१२३) (स भ.त./१/६)</p>", "skipped": false, "error": false, "bbox": [80.988, 1941.925, 762.24, 2094.585]}, {"polygon": [[833.7, 152.66000000000003], [1205.292, 152.66000000000003], [1205.292, 199.80499999999998], [833.7, 199.80499999999998]], "confidence": 0.9832803727542067, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 15, "html": "<h2>४. प्रमाणके भेदोंका समीकरण</h2>", "skipped": false, "error": false, "bbox": [833.7, 152.66000000000003, 1205.292, 199.80499999999998]}, {"polygon": [[806.7040000000001, 211.03], [1507.012, 211.03], [1507.012, 392.875], [806.7040000000001, 392.875]], "confidence": 0.9832803727542067, "label": "Text", "raw_label": "Text", "reading_order": 16, "html": "<p>स.सि./१/६/२०/३ तत्र स्वार्थं प्रमाणं श्रुतवर्जम् (वर्जम्) । श्रुत पुन. स्वार्थ भवति परार्थ च । = श्रुतज्ञानका छोडकर शेष सब ( अर्थात् शेष चार) ज्ञान स्वार्थ प्रमाण है । परन्तु श्रुतज्ञान स्वार्थ और पदार्थ दोनों प्रकारका है । ( इस प्रकार स्वार्थ व परार्थ भो प्रत्यक्ष व परोक्षमे अन्तर्भूत है । )</p>", "skipped": false, "error": false, "bbox": [806.7040000000001, 211.03, 1507.012, 392.875]}, {"polygon": [[806.7040000000001, 390.63], [1511.7759999999998, 390.63], [1511.7759999999998, 608.3950000000001], [806.7040000000001, 608.3950000000001]], "confidence": 0.9832803727542067, "label": "Text", "raw_label": "Text", "reading_order": 17, "html": "<p>रा.वा./१/२०/१५/७८/१० एतान्यनुमानादीनि श्रुते अन्तर्भवच्चित तस्मात्तेषा पृथगुपदेशो न क्रियते । स्वपरप्रतिपत्तिविषयत्वादक्षरानक्षरश्रुते अन्तर्भवति । = अनुमानादिका ( अनुमान, उपमान, शब्द, ऐतिह्य, अर्थापति, सभव और अभाव प्रमाणका) स्वप्रतिपत्तिकालमे अनक्षर श्रुतमे और परप्रतिपत्तिकालमे अक्षर श्रुतमे अन्तर्भाव होता है । इसलिए इनका पृथक् उपदेश नहीं किया है ।</p>", "skipped": false, "error": false, "bbox": [806.7040000000001, 390.63, 1511.7759999999998, 608.3950000000001]}, {"polygon": [[806.7040000000001, 603.9050000000001], [1511.7759999999998, 603.9050000000001], [1511.7759999999998, 787.995], [806.7040000000001, 787.995]], "confidence": 0.9832803727542067, "label": "Text", "raw_label": "Text", "reading_order": 18, "html": "<p>आ.प./६ सविकल्प मानस तच्चतुर्विधम् । मतिश्रुतावधिमन'पर्यय-रूपम् । निविकल्पं मनोरहितं केवलज्ञानं । = मति, श्रुत, अवधि व मन.पर्यय ये चार सविकल्प है, और केवलज्ञान निविकल्प और मन-रहित है । ( इस प्रकार ये भेद भो प्रत्यक्ष व परोक्षमें ही गर्भित हो जाते है । )</p>", "skipped": false, "error": false, "bbox": [806.7040000000001, 603.9050000000001, 1511.7759999999998, 787.995]}, {"polygon": [[833.7, 799.2199999999999], [1140.184, 799.2199999999999], [1140.184, 841.875], [833.7, 841.875]], "confidence": 0.9832803727542067, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 19, "html": "<h3>५. प्रमाणाभासका लक्षण</h3>", "skipped": false, "error": false, "bbox": [833.7, 799.2199999999999, 1140.184, 841.875]}, {"polygon": [[806.7040000000001, 853.1], [1511.7759999999998, 853.1], [1511.7759999999998, 929.43], [806.7040000000001, 929.43]], "confidence": 0.9832803727542067, "label": "Text", "raw_label": "Text", "reading_order": 20, "html": "<p>स.म.त /७४/४ मिथ्यानेकान्त. प्रमाणाभास. । = मिथ्या अनेकान्त प्रमाणाभास है ।</p>", "skipped": false, "error": false, "bbox": [806.7040000000001, 853.1, 1511.7759999999998, 929.43]}, {"polygon": [[806.7040000000001, 924.9399999999999], [1432.376, 924.9399999999999], [1432.376, 965.35], [806.7040000000001, 965.35]], "confidence": 0.9832803727542067, "label": "Text", "raw_label": "Text", "reading_order": 21, "html": "<p>दे० प्रमाण/४।२ ( सशयादि रहित मिथ्याज्ञान प्रमाणाभास है । )</p>", "skipped": false, "error": false, "bbox": [806.7040000000001, 924.9399999999999, 1432.376, 965.35]}, {"polygon": [[806.7040000000001, 960.86], [1308.512, 960.86], [1308.512, 1001.27], [806.7040000000001, 1001.27]], "confidence": 0.9832803727542067, "label": "Text", "raw_label": "Text", "reading_order": 22, "html": "<p>दे० प्रमाण/२/८ ( प्रमाणाभासके विषय संख्यादि । )</p>", "skipped": false, "error": false, "bbox": [806.7040000000001, 960.86, 1308.512, 1001.27]}, {"polygon": [[806.7040000000001, 1055.1499999999999], [1032.2, 1055.1499999999999], [1032.2, 1102.295], [806.7040000000001, 1102.295]], "confidence": 0.9832803727542067, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 23, "html": "<h2>२. प्रमाण निर्देश</h2>", "skipped": false, "error": false, "bbox": [806.7040000000001, 1055.1499999999999, 1032.2, 1102.295]}, {"polygon": [[833.7, 1122.5], [1097.308, 1122.5], [1097.308, 1165.155], [833.7, 1165.155]], "confidence": 0.9832803727542067, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 24, "html": "<h3>१. ज्ञान ही प्रमाण है</h3>", "skipped": false, "error": false, "bbox": [833.7, 1122.5, 1097.308, 1165.155]}, {"polygon": [[806.7040000000001, 1171.89], [1511.7759999999998, 1171.89], [1511.7759999999998, 1286.385], [806.7040000000001, 1286.385]], "confidence": 0.9832803727542067, "label": "Text", "raw_label": "Text", "reading_order": 25, "html": "<p>ति.प./१/८३ णार्ण होदि पमाण । = ज्ञान ही प्रमाण है । ( सि वि./सू./१/३/१२; १/२३/६६; १०/२/६६३), ( ध. १/१,१,१/गा, ११/१७), ( न. च. वृ /१७०), ( प. सु./१/१), ( प. ध./सू /५४१) ।</p>", "skipped": false, "error": false, "bbox": [806.7040000000001, 1171.89, 1511.7759999999998, 1286.385]}, {"polygon": [[833.7, 1290.875], [1370.444, 1290.875], [1370.444, 1338.02], [833.7, 1338.02]], "confidence": 0.9832803727542067, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 26, "html": "<h3>२. सम्यग्ज्ञान ही प्रमाण है मिथ्याज्ञान नहीं</h3>", "skipped": false, "error": false, "bbox": [833.7, 1290.875, 1370.444, 1338.02]}, {"polygon": [[806.7040000000001, 1349.245], [1511.7759999999998, 1349.245], [1511.7759999999998, 1535.5800000000002], [806.7040000000001, 1535.5800000000002]], "confidence": 0.9832803727542067, "label": "Text", "raw_label": "Text", "reading_order": 27, "html": "<p>श्लो. वा ३/१/२०/३८/६५ मिथ्याज्ञानं प्रमाणं न सम्यगित्यधिकारत. । यथा यत्राविसंवादस्तथा तत्र प्रमाणता ।३८। = सूत्रमे सम्यक्का अधिकार चला आ रहा है, इस कारण संशयादि मिथ्याज्ञान प्रमाण नहीं है । जिस प्रकार जहाँपर अविसंवाद है वहाँ उस प्रकार प्रमाण-पना व्यवस्थित है ।</p>", "skipped": false, "error": false, "bbox": [806.7040000000001, 1349.245, 1511.7759999999998, 1535.5800000000002]}, {"polygon": [[806.7040000000001, 1540.0700000000002], [1511.7759999999998, 1540.0700000000002], [1511.7759999999998, 1688.24], [806.7040000000001, 1688.24]], "confidence": 0.9832803727542067, "label": "Text", "raw_label": "Text", "reading_order": 28, "html": "<p>त सा /१/३५ मति' श्रुतावधिश्चैव मिथ्यत्वसमवायिन. । मिथ्याज्ञानानि कथ्यन्ते न तु तेषां प्रमाणता ।३६। = मिथ्यात्वरूप परिणाम होनेसे मति, श्रुत व अवधिज्ञान मिथ्याज्ञान कहे जाते है । ये ज्ञान मिथ्या हो तो प्रमाण नहीं माने जाते ।</p>", "skipped": false, "error": false, "bbox": [806.7040000000001, 1540.0700000000002, 1511.7759999999998, 1688.24]}, {"polygon": [[806.7040000000001, 1683.75], [1329.156, 1683.75], [1329.156, 1721.915], [806.7040000000001, 1721.915]], "confidence": 0.9832803727542067, "label": "Text", "raw_label": "Text", "reading_order": 29, "html": "<p>दे० प्रमाण/४/२ सशयादि सहित ज्ञान प्रमाण नहीं है ।</p>", "skipped": false, "error": false, "bbox": [806.7040000000001, 1683.75, 1329.156, 1721.915]}, {"polygon": [[833.7, 1737.63], [1511.7759999999998, 1737.63], [1511.7759999999998, 1789.265], [833.7, 1789.265]], "confidence": 0.9832803727542067, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 30, "html": "<h3>३. परोक्षज्ञान देशतः और प्रत्यक्षज्ञान सर्वतः प्रमाण है</h3>", "skipped": false, "error": false, "bbox": [833.7, 1737.63, 1511.7759999999998, 1789.265]}, {"polygon": [[806.7040000000001, 1798.2450000000001], [1511.7759999999998, 1798.2450000000001], [1511.7759999999998, 1946.415], [806.7040000000001, 1946.415]], "confidence": 0.9832803727542067, "label": "Text", "raw_label": "Text", "reading_order": 31, "html": "<p>श्लो. वा. ३/१/१०/३६/६६ स्वार्थे मतिश्रुतज्ञानं प्रमाणं देशतः स्थितं । अबध्यादि तु कात्स्न्येन केवलं सर्ववस्तुषु ।३६। = स्व विषयमें भी एक-देश प्रमाण है मति, श्रुतज्ञान। अवधि व मन पर्यय स्व विषयमें पूर्ण प्रमाण है । और केवलज्ञान सर्वत्र प्रमाण है ।</p>", "skipped": false, "error": false, "bbox": [806.7040000000001, 1798.2450000000001, 1511.7759999999998, 1946.415]}, {"polygon": [[806.7040000000001, 1941.925], [1511.7759999999998, 1941.925], [1511.7759999999998, 2092.34], [806.7040000000001, 2092.34]], "confidence": 0.9832803727542067, "label": "Text", "raw_label": "Text", "reading_order": 32, "html": "<p>श्लो. वा २/१/६/१८-२६/३८३ में भाषाकार द्वारा समन्तभद्राचार्यका उद्धृत वाक्य—मिथ्याज्ञान भी स्वाशकी अपेक्षा कर्य चित् प्रमाण है ।</p><p>दे० ज्ञान/III/२/८ ( ज्ञान वास्तवमें मिथ्या नहीं है वल्कि मिथ्यात्वरूप अभिप्रायवश उसे मिथ्या कहा जाता है ।</p>", "skipped": false, "error": false, "bbox": [806.7040000000001, 1941.925, 1511.7759999999998, 2092.34]}, {"polygon": [[665.372, 2119.2799999999997], [911.512, 2119.2799999999997], [911.512, 2164.18], [665.372, 2164.18]], "confidence": 0.9832803727542067, "label": "PageFooter", "raw_label": "Page-Footer", "reading_order": 33, "html": "<p>जैनेन्द्र सिद्धान्त कोश</p>", "skipped": false, "error": false, "bbox": [665.372, 2119.2799999999997, 911.512, 2164.18]}], "image_bbox": [0.0, 0.0, 1588.0, 2245.0]}