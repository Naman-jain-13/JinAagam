3.28]], "confidence": 0.9752444341487756, "label": "Text", "raw_label": "Text", "reading_order": 5, "html": "<p>प पु /सर्ग/श्लोक २२/१६०-१६२ रघु</p>", "skipped": false, "error": false, "bbox": [87.34, 278.38, 449.40399999999994, 323.28]}, {"polygon": [[90.516, 332.26], [778.12, 332.26], [778.12, 621.865], [90.516, 621.865]], "confidence": 0.9752444341487756, "label": "Diagram", "raw_label": "Diagram", "reading_order": 6, "html": "", "skipped": true, "error": false, "bbox": [90.516, 332.26, 778.12, 621.865]}, {"polygon": [[133.392, 633.0899999999999], [314.42400000000004, 633.0899999999999], [314.42400000000004, 675.745], [133.392, 675.745]], "confidence": 0.9752444341487756, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 7, "html": "<p><b>१२. राक्षसवंश</b></p>", "skipped": false, "error": false, "bbox": [133.392, 633.0899999999999, 314.42400000000004, 675.745]}, {"polygon": [[96.868, 677.99], [768.592, 677.99], [768.592, 936.165], [96.868, 936.165]], "confidence": 0.9752444341487756, "label": "Text", "raw_label": "Text", "reading_order": 8, "html": "<p>प. पु /सर्ग/श्लोक मेववाहन नामक विद्याधरको राक्षसोके इन्द्र भीम व सुभीमने भगवान् अजितनाथके समवशरणमें प्रसन्न होकर रक्षार्थ राक्षस द्वीपमें लंकाका राज्य दिया था (५/१५१-१६०) तथा पाताल लका व राक्षसो विद्या भी प्रदान की थी। (५/१६१-१६७) इसी मेघ-वाहनकी सन्तान परम्परामें एक राक्षस नामा राजा हुआ है, उसोके नामपर इस वंशका नाम 'राक्षसवंश' प्रसिद्ध हुआ। (५/२७८) इसकी वशावली निम्न प्रकार है—</p>", "skipped": false, "error": false, "bbox": [96.868, 677.99, 768.592, 936.165]}, {"polygon": [[74.636, 940.655], [773.356, 940.655], [773.356, 1551.2949999999998], [74.636, 1551.2949999999998]], "confidence": 0.9752444341487756, "label": "Diagram", "raw_label": "Diagram", "reading_order": 9, "html": "", "skipped": true, "error": false, "bbox": [74.636, 940.655, 773.356, 1551.2949999999998]}, {"polygon": [[100.044, 1551.2949999999998], [773.356, 1551.2949999999998], [773.356, 1634.36], [100.044, 1634.36]], "confidence": 0.9752444341487756, "label": "Text", "raw_label": "Text", "reading_order": 10, "html": "<p>इस प्रकार मेघवाहनकी सन्तान परम्परा क्रमपूर्वक चलती रही (५/३७७) उसी सन्तान परम्परामें एक मनोवेग राजा हुआ (५/३७८)</p>", "skipped": false, "error": false, "bbox": [100.044, 1551.2949999999998, 773.356, 1634.36]}, {"polygon": [[133.392, 1634.36], [514.5120000000001, 1634.36], [514.5120000000001, 1782.5300000000002], [133.392, 1782.5300000000002]], "confidence": 0.9752444341487756, "label": "Diagram", "raw_label": "Diagram", "reading_order": 11, "html": "", "skipped": true, "error": false, "bbox": [133.392, 1634.36, 514.5120000000001, 1782.5300000000002]}, {"polygon": [[128.62800000000001, 1798.2450000000001], [778.12, 1798.2450000000001], [778.12, 2092.34], [128.62800000000001, 2092.34]], "confidence": 0.9752444341487756, "label": "Text", "raw_label": "Text", "reading_order": 12, "html": "<p>भीमप्रभ, पूर्जाह आदि १०८ पुत्र, जिनभास्कर, स परिकीर्ति, सुग्रीव, हरियोव, श्रीप्रोव, सुमुख, सुश्रष्ट, अमृतवेग, भानुगति, चिन्तागति, इन्द्र, इन्द्रप्रभ, मेघ, मृगारिदमन, पवन, इन्द्रज्वित, भानु-वर्मा. भानु, भानुप्रभ, सुरारि, त्रिजट, भीम, मोहन, उद्धारक, रवि, चकार, वज्रमध्य, प्रमोद, सिहविक्रम, चामुण्ड, मारण, भीष्म द्वीप-वाह, अरिमर्दन, निर्वाणभक्ति, उघश्री, अहंद्भक्ति, अनुत्तर, गतभ्रम, अनिल, चण्ड लकाशोक, मधूरवान, महाबाहु, मनोरम्य, भास्कराभ, बृहद्भगति, बृहत्कान्त, अरिसन्त्रास, चन्द्रावर्त, महारव, मेघवान,</p>", "skipped": false, "error": false, "bbox": [128.62800000000001, 1798.2450000000001, 778.12, 2092.34]}, {"polygon": [[835.288, 145.925], [1503.836, 145.925], [1503.836, 224.5], [835.288, 224.5]], "confidence": 0.9752444341487756, "label": "Text", "raw_label": "Text", "reading_order": 13, "html": "<p>गृहक्षोभ, नक्षत्रदम आदि करोडों विद्याधर इस वंशमें हुए...पनप्रभ, कीर्तिधवल। (५/३८२-३८८)</p>", "skipped": false, "error": false, "bbox": [835.288, 145.925, 1503.836, 224.5]}, {"polygon": [[835.288, 224.5], [1499.072, 224.5], [1499.072, 296.34000000000003], [835.288, 296.34000000000003]], "confidence": 0.9752444341487756, "label": "Text", "raw_label": "Text", "reading_order": 14, "html": "<p>भगवान् मुनिसुवतके तीर्थमें विद्यात्केश नामक राजा हुआ। (६/२२२-२२३) इसका पुत्र सुकेश हुआ। (६/३४१)।</p>", "skipped": false, "error": false, "bbox": [835.288, 224.5, 1499.072, 296.34000000000003]}, {"polygon": [[816.232, 300.83000000000004], [1440.316, 300.83000000000004], [1440.316, 669.01], [816.232, 669.01]], "confidence": 0.9752444341487756, "label": "Diagram", "raw_label": "Diagram", "reading_order": 15, "html": "", "skipped": true, "error": false, "bbox": [816.232, 300.83000000000004, 1440.316, 669.01]}, {"polygon": [[843.2280000000001, 684.725], [1022.672, 684.725], [1022.672, 725.135], [843.2280000000001, 725.135]], "confidence": 0.9752444341487756, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 16, "html": "<p><b>१३. वानरवंश</b></p>", "skipped": false, "error": false, "bbox": [843.2280000000001, 684.725, 1022.672, 725.135]}, {"polygon": [[816.232, 725.135], [1514.952, 725.135], [1514.952, 1162.91], [816.232, 1162.91]], "confidence": 0.9752444341487756, "label": "Text", "raw_label": "Text", "reading_order": 17, "html": "<p>प पु./सर्ग/श्लोक नं. राक्षस वशीय राजा कीर्तिधवजने राजा श्रीकण्ठको (जब बहु पद्मोत्तर विद्याधरसे हार गया) सुरक्षित रूपसे रहनेके लिए वानर द्वीप प्रदान किया था (६/८३ ८४)। वहाँ पर उसने किछु पर्वतपर किछुपुर नगरकी रचना की। वहाँ पर वानर अधिक रहते थे जिनसे राजा श्रीकण्ठको बहुत अधिक प्रेम हो गया था। (६/१०७-१६२)। तदनन्तर इसी श्रीकण्ठकी पुत्र परम्परामें अमरप्रभ नामक राजा हुआ। उसके विवाहके समय मण्डपमें वानरोकी पंक्तियाँ चिह्नित की गयी थीं, तब अमरप्रभने बुद्ध मन्त्रियोंसे यह जाना कि “हमारे पूर्वजोने वानरोंसे प्रेम किया था तथा इन्हें मंगल रूप मान-कर इनका पोषण किया था।” यह जानकर राजाने अपने मुकुटोंमें वानरोके चिह्न कराये। उसी समयसे इस वंशका नाम वानरवंश पड गया। (६/१७५-२१७) (इसकी वशावली निम्न प्रकार है)—</p>", "skipped": false, "error": false, "bbox": [816.232, 725.135, 1514.952, 1162.91]}, {"polygon": [[816.232, 1162.91], [1514.952, 1162.91], [1514.952, 1481.7], [816.232, 1481.7]], "confidence": 0.9752444341487756, "label": "Text", "raw_label": "Text", "reading_order": 18, "html": "<p>प पु. ६/श्लोक विजयार्थकी दक्षिण श्रेणीका राजा अतीन्द्र (३)था। तद-नन्तर श्रीकण्ठ (५), बज्रकण्ठ (१५२), बज्रप्रभ (१६०), इन्द्रमत (१६१), मेरु (१६१), मन्दर (१६१), समीरणगति (१६१), रविप्रभ (१६१), अमरप्रभ (१६२), कपिकेतु (१६८), प्रतिबल (२००), गगनानन्द (२०५), खेचरानन्द (२०५), गिरिनन्दन (२०५), इस प्रकार सैवडो राजा इस वंशमें हुए, उनमें से कितनोंने स्वर्ग व कितनों ने मोक्ष प्राप्त किया। (२०६)। जिस समय भगवान् मुनिसुवतका तीर्थ चल रहा था (२२२) तब इसीवंशमे एक महोदधि राजा हुआ (२१८)। उसका भी पुत्र प्रतिचन्द्र हुआ (३४१)।</p>", "skipped": false, "error": false, "bbox": [816.232, 1162.91, 1514.952, 1481.7]}, {"polygon": [[835.288, 1481.7], [1424.436, 1481.7], [1424.436, 1852.125], [835.288, 1852.125]], "confidence": 0.9752444341487756, "label": "Diagram", "raw_label": "Diagram", "reading_order": 19, "html": "", "skipped": true, "error": false, "bbox": [835.288, 1481.7, 1424.436, 1852.125]}, {"polygon": [[843.2280000000001, 1867.84], [1075.076, 1867.84], [1075.076, 1910.495], [843.2280000000001, 1910.495]], "confidence": 0.9752444341487756, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 20, "html": "<p><b>१४. विद्याधर वंश</b></p>", "skipped": false, "error": false, "bbox": [843.2280000000001, 1867.84, 1075.076, 1910.495]}, {"polygon": [[816.232, 1910.495], [1514.952, 1910.495], [1514.952, 2092.34], [816.232, 2092.34]], "confidence": 0.9752444341487756, "label": "Text", "raw_label": "Text", "reading_order": 21, "html": "<p>जिस समय भगवान् ऋषभदेव भरतेश्वरको राज्य देकर दीक्षित हुए, उस समय उनके साथ चार हजार भोजवशीय व उग्रवंशीय आदि राजा भी तपमें दिथत हुए थे। पीछे चलकर वे सब भ्रष हो गये। उनमें-से नमि और विनमि आकर भगवान्के चरणोंमें राज्यकी इच्छासे बैठ गये। उसी समय रक्षामे निपुण धरणेन्द्रने अनेको देवों</p>", "skipped": false, "error": false, "bbox": [816.232, 1910.495, 1514.952, 2092.34]}, {"polygon": [[670.136, 2121.525], [911.