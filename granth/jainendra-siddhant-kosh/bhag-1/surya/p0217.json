 [[112.74799999999999, 374.915], [751.1239999999999, 374.915], [751.1239999999999, 525.33], [112.74799999999999, 525.33]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 5, "html": "<p><b>अवस्थित—</b>स. सि. १/४/१७१/१ धर्मादीनि षडपि द्रव्याणि कदाचि-दपि षडिति इयत्त्वं नातिवर्तन्ते । ततोऽन्स्थितानीत्युच्यते । = धर्म-विक छहों द्रव्य कभी भी छह. इस संस्थाका उल्लंघन नहीं करते, इसलिए वे अवस्थित कहे जाते हैं ।</p>", "skipped": false, "error": false, "bbox": [112.74799999999999, 374.915, 751.1239999999999, 525.33]}, {"polygon": [[112.74799999999999, 525.33], [549.448, 525.33], [549.448, 572.475], [112.74799999999999, 572.475]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 6, "html": "<p><b>अवस्थित अवधिज्ञान—</b>दे. अवधिज्ञान ।</p>", "skipped": false, "error": false, "bbox": [112.74799999999999, 525.33, 549.448, 572.475]}, {"polygon": [[112.74799999999999, 572.475], [511.336, 572.475], [511.336, 619.62], [112.74799999999999, 619.62]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 7, "html": "<p><b>अवस्थित गुणश्रेणी—</b>दे. संक्रमण/८ ।</p>", "skipped": false, "error": false, "bbox": [112.74799999999999, 572.475, 511.336, 619.62]}, {"polygon": [[112.74799999999999, 619.62], [487.516, 619.62], [487.516, 666.765], [112.74799999999999, 666.765]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 8, "html": "<p><b>अवस्थित बंध—</b>दे. प्रकृति बंध/१ ।</p>", "skipped": false, "error": false, "bbox": [112.74799999999999, 619.62, 487.516, 666.765]}, {"polygon": [[112.74799999999999, 666.765], [444.64000000000004, 666.765], [444.64000000000004, 713.91], [112.74799999999999, 713.91]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 9, "html": "<p><b>अवांतर सत्ता—</b>दे. अस्तित्व ।</p>", "skipped": false, "error": false, "bbox": [112.74799999999999, 666.765, 444.64000000000004, 713.91]}, {"polygon": [[112.74799999999999, 713.91], [358.88800000000003, 713.91], [358.88800000000003, 763.3000000000001], [112.74799999999999, 763.3000000000001]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 10, "html": "<p><b>अवाक्—</b>दक्षिण दिशा ।</p>", "skipped": false, "error": false, "bbox": [112.74799999999999, 713.91, 358.88800000000003, 763.3000000000001]}, {"polygon": [[112.74799999999999, 774.525], [230.26, 774.525], [230.26, 812.6899999999999], [112.74799999999999, 812.6899999999999]], "confidence": 0.9768413312871416, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 11, "html": "<h2>अवाय—</h2>", "skipped": false, "error": false, "bbox": [112.74799999999999, 774.525, 230.26, 812.6899999999999]}, {"polygon": [[139.744, 819.425], [349.36, 819.425], [349.36, 862.08], [139.744, 862.08]], "confidence": 0.9768413312871416, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 12, "html": "<h3>१. अवायका लक्षण</h3>", "skipped": false, "error": false, "bbox": [139.744, 819.425, 349.36, 862.08]}, {"polygon": [[103.22, 862.08], [751.1239999999999, 862.08], [751.1239999999999, 974.33], [103.22, 974.33]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 13, "html": "<p>ष. ख. १३/५.५/मू. ३१/२४३ अवायो ववसायो बुद्धी विष्णाणि आउ'डी पञ्चाउ'डी ॥३१॥ = अवाय, व्यवसाय, बुद्धि, विज्ञप्ति, अमुण्डा और प्रस्यामुण्डा ये पर्याय नाम हैं ।</p>", "skipped": false, "error": false, "bbox": [103.22, 862.08, 751.1239999999999, 974.33]}, {"polygon": [[103.22, 967.595], [751.1239999999999, 967.595], [751.1239999999999, 1144.95], [103.22, 1144.95]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 14, "html": "<p>स. सि. १/१५/१११/६ विशेषनिर्ज्ञानाद्याधात्म्यावगमनमवायः । उत्पत्तन-निपत्तनपसविक्षेपादिभिर्वलाकेवेयं न पताकेति । = विशेषके निर्णय द्वारा जो यथार्थ ज्ञान होता है उसे अवाय कहते हैं । जैसे उत्पत्तन, निपत्तन, पस-विक्षेप आदिके द्वारा 'यह बक पंक्ति हो है, ध्वजा नहीं' ऐसा निश्चय होना अवाय है । (य. १३/५.५.२३/२१८/६)</p>", "skipped": false, "error": false, "bbox": [103.22, 967.595, 751.1239999999999, 1144.95]}, {"polygon": [[103.22, 1140.46], [751.1239999999999, 1140.46], [751.1239999999999, 1317.8149999999998], [103.22, 1317.8149999999998]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 15, "html": "<p>रा. वा. १/१५/३/६०/६ भाषादिविशेषनिर्ज्ञानात्तस्य याथात्म्येनावगमन-मवायः । 'दाक्षिणात्योऽयम्, युवा, गौरः' इति वा = भाषा आदि विशेषोंके द्वारा उस ( ईहा द्वारा गृहीत पुरुष ) की उस विशेषताका यथार्थ ज्ञान कर लेना अवाय है, जैसे यह दक्षिणी है, युवा है या गौर है इत्यादि । ( न्या. दी. /२/४११/३२/६)</p>", "skipped": false, "error": false, "bbox": [103.22, 1140.46, 751.1239999999999, 1317.8149999999998]}, {"polygon": [[103.22, 1313.3249999999998], [751.1239999999999, 1313.3249999999998], [751.1239999999999, 1423.33], [103.22, 1423.33]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 16, "html": "<p>ध. १३/५.५.३१/२४३/३ अबेयते निश्चीयते मीमांसितोऽर्थोऽनेत्यवायः । = जिसके द्वारा मीमांसित अर्थ 'अबेयते' अर्थात् निश्चित किया जाता है वह अवाय नै ।</p>", "skipped": false, "error": false, "bbox": [103.22, 1313.3249999999998, 751.1239999999999, 1423.33]}, {"polygon": [[103.22, 1418.84], [751.1239999999999, 1418.84], [751.1239999999999, 1526.6000000000001], [103.22, 1526.6000000000001]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 17, "html": "<p>ध. ६/१.६-१.१४/१७/७ ईहितस्पार्थस्य संदेहापोहनमवायः । = ईहा ज्ञान-से जाने गये पदार्थ विषयक सन्देहका दूर हो जाना (या निश्चय हो जाना) अवाय है । (ध. १/१.१.११५/३५४/३) (ष. १/४.१.४/१४४/७)</p>", "skipped": false, "error": false, "bbox": [103.22, 1418.84, 751.1239999999999, 1526.6000000000001]}, {"polygon": [[103.22, 1522.1100000000001], [751.1239999999999, 1522.1100000000001], [751.1239999999999, 1807.2250000000001], [103.22, 1807.2250000000001]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 18, "html": "<p>ज. प. १३/५.६.६३ ईहितस्पार्थस्स पुणो थाणु पुरिसो त्ति बहुविष्यप्स । जो णिच्छियावनोधो सो दु अवाओ वियाणाहि ॥११॥ जो कम्म-कलुसरहिओ सो देवो णत्थि एत्थ संदेहो । जस्स दु एवं बुद्धी अवाय-वाणं हवे तस्स ॥६३॥ = यह स्थाणु है या पुरुष, इस प्रकार बहुत विकल्परूप ईहित पदार्थके विषयमें जो निश्चित ज्ञान होता है उसे अवाय जानना चाहिए ॥११॥ जो कर्ममलसे रहित होता है वह देव है, इसमें कोई सन्देह नहीं है, इस प्रकार जिसके निश्चयरूप बुद्धि होती है उसके अवायज्ञान होता है ॥६३॥</p>", "skipped": false, "error": false, "bbox": [103.22, 1522.1100000000001, 751.1239999999999, 1807.2250000000001]}, {"polygon": [[134.98000000000002, 1813.96], [543.096, 1813.96], [543.096, 1858.86], [134.98000000000002, 1858.86]], "confidence": 0.9768413312871416, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 19, "html": "<h3>२. इस ज्ञानको अवाय कहें या अपाय</h3>", "skipped": false, "error": false, "bbox": [134.98000000000002, 1813.96, 543.096, 1858.86]}, {"polygon": [[103.22, 1854.37], [751.1239999999999, 1854.37], [751.1239999999999, 2072.135], [103.22, 2072.135]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 20, "html": "<p>रा. वा. १/१५/१३/६१/१ आह-किमयम् अपाय उत अवाय इति । उभ-यथा न दीषः । अन्यतरबचनेऽन्यतरस्यार्थ गृहीतत्वात् । यथा 'न दाक्षिणात्योऽयम्' इत्यपायं स्यागं करोति तदा 'औदीच्यः' इत्य-वायोऽधिगमोऽर्थ गृहीतः । यदा च 'औदीच्यः; इत्यवायं करोति तदा 'न दाक्षिणात्योऽयम्' इत्यपायोऽर्थ गृहीतः = प्रश्न—अवाय नामठीक है या अपाय । उत्तर—दोनों ही ठीक हैं, क्योंकि एकके वचनमें दूसरे-</p>", "skipped": false, "error": false, "bbox": [103.22, 1854.37, 751.1239999999999, 2072.135]}, {"polygon": [[822.5840000000001, 184.09], [1467.3120000000001, 184.09], [1467.3120000000001, 323.28], [822.5840000000001, 323.28]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 21, "html": "<p>का ग्रहण स्वतः हो जाता है । जैसे अब 'यह दक्षिणी नहीं है' ऐसा अपाय त्याग करता है तब 'उत्तरी है' यह अवाय-निश्चय हो ही जाता है । इसो तरह 'उत्तरी है' इस प्रकार अवाय या निश्चय होने-पर 'दक्षिणी नहीं है' यह अपाय या त्याग हो ही जाता है ।</p>", "skipped": false, "error": false, "bbox": [822.5840000000001, 184.09, 1467.3120000000001, 323.28]}, {"polygon": [[822.5840000000001, 325.525], [1108.424, 325.525], [1108.424, 363.69], [822.5840000000001, 363.69]], "confidence": 0.9768413312871416, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 22, "html": "<h3>३. अन्य सम्बन्धित विपत्तः</h3>", "skipped": false, "error": false, "bbox": [822.5840000000001, 325.525, 1108.424, 363.69]}, {"polygon": [[849.58, 363.69], [1457.784, 363.69], [1457.784, 406.34499999999997], [849.58, 406.34499999999997]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 23, "html": "<p>१. अवायज्ञानको 'मत्ति' व्यपदेश कैसे ? —दे. मतिज्ञान ३</p>", "skipped": false, "error": false, "bbox": [849.58, 363.69, 1457.784, 406.34499999999997]}, {"polygon": [[849.58, 401.85499999999996], [1457.784, 401.85499999999996], [1457.784, 471.45], [849.58, 471.45]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 24, "html": "<p>२. अवग्रहमे अवाय पर्यन्त मतिज्ञानकी उत्पत्तिका क्रम —दे. मतिज्ञान ३</p>", "skipped": false, "error": false, "bbox": [849.58, 401.85499999999996, 1457.784, 471.45]}, {"polygon": [[849.58, 464.715], [1298.984, 464.715], [1298.984, 502.88], [849.58, 502.88]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 25, "html": "<p>३. अवग्रह य अवायमें अन्तर —दे. अवग्रह २</p>", "skipped": false, "error": false, "bbox": [849.58, 464.715, 1298.984, 502.88]}, {"polygon": [[849.58, 496.145], [1346.624, 496.145], [1346.624, 529.8199999999999], [849.58, 529.8199999999999]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 26, "html": "<p>४. अपाय व धृतज्ञानमें अन्तर —दे. धृतज्ञान ।</p>", "skipped": false, "error": false, "bbox": [849.58, 496.145, 1346.624, 529.8199999999999]}, {"polygon": [[849.58, 523.085], [1300.572, 523.085], [1300.572, 561.25], [849.58, 561.25]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 27, "html": "<p>५. अवाय व धारणामें अन्तर —दे. धारणा २</p>", "skipped": false, "error": false, "bbox": [849.58, 523.085, 1300.572, 561.25]}, {"polygon": [[798.764, 561.25], [1071.9, 561.25], [1071.9, 603.9050000000001], [798.764, 603.9050000000001]], "confidence": 0.9768413312871416, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 28, "html": "<h2>अविकल्प —दे. चिकल्प ।</h2>", "skipped": false, "error": false, "bbox": [798.764, 561.25, 1071.9, 603.9050000000001]}, {"polygon": [[798.764, 603.9050000000001], [1408.556, 603.9050000000001], [1408.556, 653.295], [798.764, 653.295]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 29, "html": "<p><b>अविकृतिकरण—</b>आलोचनाका एक दीप—दे. आलोचना २ ।</p>", "skipped": false, "error": false, "bbox": [798.764, 603.9050000000001, 1408.556, 653.295]}, {"polygon": [[798.764, 653.295], [1459.372, 653.295], [1459.372, 734.115], [798.764, 734.115]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 30, "html": "<p><b>अविज्ञातार्थ—</b>न्या. मू./मू. ५-२/६ परिपत्त्रतिवादिभ्यो विरभि-हितमप्यविज्ञातमविज्ञातार्थ म् ॥४॥</p>", "skipped": false, "error": false, "bbox": [798.764, 653.295, 1459.372, 734.115]}, {"polygon": [[798.764, 729.625], [1464.136, 729.625], [1464.136, 1046.17], [798.764, 1046.17]], "confidence": 0.9768413312871416, "label": "Text", "raw_label": "Text", "reading_order": 31, "html": "<p>न्या. मू./मा. ५-२/६ यद्वावयं परिषदों प्रतिवादिना च विरभिहितमपि न विज्ञायन्ते श्लिष्टशब्दमत्तीतप्रयोगमतिद्रुतःचरितर्मत्येवमादिना कारणेन तदविज्ञातमविज्ञातार्थ मसामर्थ्यसंवरणाय प्रयुक्तर्मिति निग्रह-स्थानमिति । = जिस अर्थकी वादो ऐसे शब्दोंते कहे जो प्रसिद्ध न हों, इस कारणसे, या अति शीघ्र उच्चार