{"blocks": [{"polygon": [[80.988, 78.575], [136.56799999999998, 78.575], [136.56799999999998, 121.23], [80.988, 121.23]], "confidence": 0.982501760871812, "label": "PageHeader", "raw_label": "Page-Header", "reading_order": 0, "html": "अर्थ", "skipped": false, "error": false, "bbox": [80.988, 78.575, 136.56799999999998, 121.23]}, {"polygon": [[759.064, 74.08500000000001], [825.76, 74.08500000000001], [825.76, 116.74], [759.064, 116.74]], "confidence": 0.982501760871812, "label": "PageHeader", "raw_label": "Page-Header", "reading_order": 1, "html": "१३५", "skipped": false, "error": false, "bbox": [759.064, 74.08500000000001, 825.76, 116.74]}, {"polygon": [[1384.736, 74.08500000000001], [1507.012, 74.08500000000001], [1507.012, 121.23], [1384.736, 121.23]], "confidence": 0.982501760871812, "label": "PageHeader", "raw_label": "Page-Header", "reading_order": 2, "html": "अर्थसंदृष्टि", "skipped": false, "error": false, "bbox": [1384.736, 74.08500000000001, 1507.012, 121.23]}, {"polygon": [[80.988, 143.68], [762.24, 143.68], [762.24, 296.34000000000003], [80.988, 296.34000000000003]], "confidence": 0.982501760871812, "label": "Text", "raw_label": "Text", "reading_order": 3, "html": "<p>रा.वा./१/२/६/१६/२३ अर्थते गम्यते ज्ञायते इत्यर्थ । = जो जाना जाये या निश्चय किया जाये उसे अर्थ कहते हैं । (रा.वा./१/३३/१/६५/४), (घ १२/४.२.१४.२/४७८/७), (घ.१३/५.५.५०/२८१/१२), (न्या. वि / व / १/६/१६५/२३) (स.म./२८/३०७/१५) (प घ / पू०./१५८) ।</p>", "skipped": false, "error": false, "bbox": [80.988, 143.68, 762.24, 296.34000000000003]}, {"polygon": [[139.744, 296.34000000000003], [444.64000000000004, 296.34000000000003], [444.64000000000004, 336.75], [139.744, 336.75]], "confidence": 0.982501760871812, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 4, "html": "<h2>२. अर्थ = द्रव्य गुण पर्याय</h2>", "skipped": false, "error": false, "bbox": [139.744, 296.34000000000003, 444.64000000000004, 336.75]}, {"polygon": [[80.988, 336.75], [762.24, 336.75], [762.24, 484.92], [80.988, 484.92]], "confidence": 0.982501760871812, "label": "Text", "raw_label": "Text", "reading_order": 5, "html": "<p>स.सि /१/१७/१९६/२ “इयत्ति पर्यायोस्तैवस्यित इत्यर्थो द्रव्यं... = जो पर्यायोको प्राप्त होता है, या जो पर्यायोंके द्वारा प्राप्त किया जाता है, यह अर्थ शब्दको व्युत्पत्ति है । इसके अनुसार अर्थ द्रव्य ठहरता है । (रा वा /१/१७/६५/३०) ।</p>", "skipped": false, "error": false, "bbox": [80.988, 336.75, 762.24, 484.92]}, {"polygon": [[80.988, 480.43], [759.064, 480.43], [759.064, 554.515], [80.988, 554.515]], "confidence": 0.982501760871812, "label": "Text", "raw_label": "Text", "reading_order": 6, "html": "<p>स.सि /१/४४/४५५ अर्थ ध्येयो द्रव्य पर्यायो वा । = अर्थ ध्येयको कहते हैं । इससे द्रव्य और पर्याय लिये जाते हैं ।</p>", "skipped": false, "error": false, "bbox": [80.988, 480.43, 759.064, 554.515]}, {"polygon": [[80.988, 550.025], [757.476, 550.025], [757.476, 660.03], [80.988, 660.03]], "confidence": 0.982501760871812, "label": "Text", "raw_label": "Text", "reading_order": 7, "html": "<p>रा वा /१/३३/१/६५/४ अर्थते गम्यते निष्पाद्यत इत्यर्थ कार्यस् । = जो जाना जाता है, प्राप्त किया जाता है, या निष्पादन किया जाता है वह ‘अर्थ’ कार्य या पर्याय है ।</p>", "skipped": false, "error": false, "bbox": [80.988, 550.025, 757.476, 660.03]}, {"polygon": [[80.988, 657.785], [757.476, 657.785], [757.476, 765.5450000000001], [80.988, 765.5450000000001]], "confidence": 0.982501760871812, "label": "Text", "raw_label": "Text", "reading_order": 8, "html": "<p>घ.१३/५.५.५०२८१/१२ अर्थते गम्यते परिच्छिद्यत इति अर्थो नव पदार्थ । = जाना जाता है वह अर्थ है । यहाँ अर्थ पदसे नौ पदार्थ लिये गये हैं ।</p>", "skipped": false, "error": false, "bbox": [80.988, 657.785, 757.476, 765.5450000000001]}, {"polygon": [[80.988, 758.8100000000001], [757.476, 758.8100000000001], [757.476, 859.835], [80.988, 859.835]], "confidence": 0.982501760871812, "label": "Text", "raw_label": "Text", "reading_order": 9, "html": "<p>प.मु /४/१ सामान्यविशेषात्मा तदर्थो विषय । = सामान्य और विशेष स्वरूप अर्थात् द्रव्य और पर्याय स्वरूप पदार्थ प्रमाण (ज्ञान) का विषय होता है ।</p>", "skipped": false, "error": false, "bbox": [80.988, 758.8100000000001, 757.476, 859.835]}, {"polygon": [[80.988, 855.345], [757.476, 855.345], [757.476, 1192.095], [80.988, 1192.095]], "confidence": 0.982501760871812, "label": "Text", "raw_label": "Text", "reading_order": 10, "html": "<p>प्र सा /त.प /८७ गुणपर्यायानियति गुणपर्यायैरर्यन्त इति वा अर्था द्रव्याणि, द्रव्याण्याश्रयत्वेनेयति द्रव्येराश्रयभूतैरर्यन्त इति वा अर्था गुणा, द्रव्याणि क्रमपरिणामेनार्यन्त इति वा अर्था पर्याया । = जो गुणोंको और पर्यायोंको प्राप्त करते है, अथवा जो गुणों और पर्यायों के द्वारा प्राप्त किये जाते हैं ऐसे ‘अर्थ’ <u>द्रव्य है</u> । जो द्रव्योंको आश्रयके रूपमें प्राप्त करते हैं अथवा जो आश्रयभूत द्रव्योंके द्वारा प्राप्त किये जाते हैं ऐसे ‘अर्थ’ गुण है । जो द्रव्योंको क्रम परिणामसे प्राप्त करते हैं, अथवा जो द्रव्योंके द्वारा क्रम परिणामसे प्राप्त किये जाते हैं, ऐसे ‘अर्थ’ <u>पर्याय है</u> ।</p>", "skipped": false, "error": false, "bbox": [80.988, 855.345, 757.476, 1192.095]}, {"polygon": [[74.636, 1189.8500000000001], [751.1239999999999, 1189.8500000000001], [751.1239999999999, 1266.1799999999998], [74.636, 1266.1799999999998]], "confidence": 0.982501760871812, "label": "Text", "raw_label": "Text", "reading_order": 11, "html": "<p>न दो./३/७६ कोऽग्रमर्थो नाम : उच्यते । अर्थोऽनेकान्तः । = अर्थ किसे कहते हैं — अनेकान्तको अर्थ कहते हैं ।</p>", "skipped": false, "error": false, "bbox": [74.636, 1189.8500000000001, 751.1239999999999, 1266.1799999999998]}, {"polygon": [[133.392, 1266.1799999999998], [409.704, 1266.1799999999998], [409.704, 1311.08], [133.392, 1311.08]], "confidence": 0.982501760871812, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 12, "html": "<h2>३. अर्थ = न्नेयरूप विश्व</h2>", "skipped": false, "error": false, "bbox": [133.392, 1266.1799999999998, 409.704, 1311.08]}, {"polygon": [[74.636, 1304.3449999999998], [752.712, 1304.3449999999998], [752.712, 1448.025], [74.636, 1448.025]], "confidence": 0.982501760871812, "label": "Text", "raw_label": "Text", "reading_order": 13, "html": "<p>प्र सा./त प /१२४ तत्र क खवर्थ, स्वपरविभागेनावस्थितं विश्व । = अर्थ क्या है ? स्व परके विभागपूर्वक अवस्थित विश्व हो अर्थ है । (वं घ /पू/५४१) (प.घ./उ /३६१) — दे नय I/४ समस्त विश्व शब्द, अर्थ व ज्ञान इन तीनमें विभक्त हैं ।</p>", "skipped": false, "error": false, "bbox": [74.636, 1304.3449999999998, 752.712, 1448.025]}, {"polygon": [[128.62800000000001, 1450.27], [355.712, 1450.27], [355.712, 1492.9250000000002], [128.62800000000001, 1492.9250000000002]], "confidence": 0.982501760871812, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 14, "html": "<h2>४. अर्थ = श्रुतज्ञान</h2>", "skipped": false, "error": false, "bbox": [128.62800000000001, 1450.27, 355.712, 1492.9250000000002]}, {"polygon": [[74.636, 1488.4350000000002], [755.8879999999999, 1488.4350000000002], [755.8879999999999, 1760.0800000000002], [74.636, 1760.0800000000002]], "confidence": 0.982501760871812, "label": "Text", "raw_label": "Text", "reading_order": 15, "html": "<p>घ.१४/५.६.१२/८/८ अत्थो गणहरदेवो, आपममुक्तेण विणा सयलमुदणाण-पञ्जाएण परिणदत्तादो । तेण समं मुदणाणं अत्थसम अथवा अत्थो बीजपद, तत्तो उपपणं सयलमुदणाणमत्थसम । = ‘अर्थ’ <u>गणधरदेव</u> का नाम है, बयोकि, वे आपम सूत्रके बिना सफल श्रुतज्ञानरूप पर्यायसे परिणत रहते हैं । इनके समान जा श्रुतज्ञान होता है वह अर्थसम श्रुतज्ञान है ? अथवा अर्थ <u>बोज पदको</u> कहते हैं, इससे जो समस्त श्रुतज्ञान उत्पन्न होता है वह अर्थ सम श्रुतज्ञान है ।</p>", "skipped": false, "error": false, "bbox": [74.636, 1488.4350000000002, 755.8879999999999, 1760.0800000000002]}, {"polygon": [[128.62800000000001, 1762.325], [341.42, 1762.325], [341.42, 1804.98], [128.62800000000001, 1804.98]], "confidence": 0.982501760871812, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 16, "html": "<h2>५. अर्थ = प्रयोजन</h2>", "skipped": false, "error": false, "bbox": [128.62800000000001, 1762.325, 341.42, 1804.98]}, {"polygon": [[74.636, 1804.98], [768.592, 1804.98], [768.592, 2101.32], [74.636, 2101.32]], "confidence": 0.982501760871812, "label": "Text", "raw_label": "Text", "reading_order": 17, "html": "<p>स.सि /१/६/२१ द्रव्यमर्थ प्रयोजनमस्येत्यसौ द्रव्यार्थिक । = द्रव्य ही अर्थ या प्रयोजन जिसका सो द्रव्यार्थिक नय है । (रा.वा./१/३३/१-६५/८) (घ.१/१,१,१/८३/११) (घ.६/४,१,४५/१७०/१) (आ.प./६) रा.वा /४/४२/१५ अर्थांकरणसम्भव अभिप्रायादिशब्दः न्यायात्कल्पितो अर्थादिगम्य । = अर्थ, अकरण, सम्भव, अभिप्राय आदि शब्द न्यायसे कल्पित किये हुए अर्थाधिगम्य कहलाते हैं, जैसे रोटी खाते हुए ‘सैन्धव लाओ’ कहनेसे नमक हो लाना, घोड़ा नहीं ऐसा स्पष्ट अभिप्राय न्यायसे सिद्ध है ।</p>", "skipped": false, "error": false, "bbox": [74.636, 1804.98, 768.592, 2101.32]}, {"polygon": [[811.468, 143.68], [1502.2479999999998, 143.68], [1502.2479999999998, 291.85], [811.468, 291.85]], "confidence": 0.982501760871812, "label": "Text", "raw_label": "Text", "reading_order": 18, "html": "<p>न्या.दी./३/९७३ अर्थ स्तावत्तात्पर्यरूढ इति यावत् । अर्थ एव तात्पर्यमेव वचसौरयभियुक्तवचनात् । = ‘अर्थ’ पद तात्पर्यमें रूढ है, अर्थात् प्रयोजनार्थक है, क्योंकि ‘अर्थ ही या तात्पर्य ही वचनोंमें है’ ऐसा आर्ष वचन है ।</p>", "skipped": false, "error": false, "bbox": [811.468, 143.68, 1502.2479999999998, 291.85]}, {"polygon": [[860.696, 294.095], [1175.12, 294.095], [1175.12, 334.505], [860.696, 334.505]], "confidence": 0.982501760871812, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 19, "html": "<h2>६. ‘अर्थ’ पदके अनेकों अर्थ</h2>", "skipped": false, "error": false, "bbox": [860.696, 294.095, 1175.12, 334.505]}, {"polygon": [[811.468, 334.505], [1497.484, 334.505], [1497.484, 702.685], [811.468, 702.685]], "confidence": 0.982501760871812, "label": "Text", "raw_label": "Text", "reading_order": 20, "html": "<p>रा.वा./१/२/१६/२०/३१ अर्थशब्दोऽर्थमनेकार्थ — कचिद् द्रव्यगुणकर्मसु वर्तते ‘अर्थ इति द्रव्यगुणकर्मसु’ (वै मू./७/२/३) इति वचनात् । कचित् प्रयोजने वर्तते ‘किमर्थमिहागमनं भवत ’ किं प्रयोजनं मिति । कचिद्वने वर्तते अर्थवानयं देवदत्त धनवानिति । कचिद्-भिधेये वर्तते शब्दार्थसम्बन्ध इति । = ‘अर्थ’ शब्दके अनेक अर्थ हैं—१ वैशेषिक शास्त्रमें द्रव्य गुण कर्म इन तीन पदार्थोंकी अर्थसंज्ञा है । २. ‘आप यहाँ किस अर्थ आये हैं’ यहाँ अर्थ शब्दका अर्थ <u>प्रयोजन है</u> । ३. ‘देवदत्त अर्थवान है’ यहाँ अर्थ शब्द घनके अर्थमें ग्रहण किया गया है—अर्थवान अर्थात् धनवान । ४. ‘शब्दार्थ-सम्बन्ध’ इस पदमें अर्थ शब्द का अर्थ अभिधेय या वाच्य है ।</p>", "skipped": false, "error": false, "bbox": [811.468, 334.505, 1497.484, 702.685]}, {"polygon": [[811.468, 698.195], [1497.484, 698.195], [1497.484, 770.0350000000001], [811.468, 770.0350000000001]], "confidence": 0.982501760871812, "label": "Text", "raw_label": "Text", "reading_order": 21, "html": "<p>प्रा.वि./वृ /१/७/१४०/१५ अर्थोऽभिधेय । = अर्थ अर्थात् अभिधेय (भ. आ /वि./११३/२६१/१२) ।</p>", "skipped": false, "error": false, "bbox": [811.468, 698.195, 1497.484, 770.0350000000001]}, {"polygon": [[811.468, 767.7900000000001], [1497.484, 767.7900000000001], [1497.484, 913.7149999999999], [811.468, 913.7149999999999]], "confidence": 0.982501760871812, "label": "Text", "raw_label": "Text", "reading_order": 22, "html": "<p>प.घ /पू /१४३ सत्ता सत्त्वं सद्वा सामान्यं द्रव्यमन्वयो वस्तु । अर्थो विधि रविशेषादेकार्थवाचका अमी शब्दा ॥१४॥ = सत्ता, सत्त्व अथवा सत्. सामान्य, द्रव्य. अन्वय, वस्तु, अर्थ और विधि ये नौ शब्द सामान्य रूपसे एक द्रव्य रूप अर्थ के हो वाचक है ।</p>", "skipped": false, "error": false, "bbox": [811.468, 767.7900000000001, 1497.484, 913.7149999999999]}, {"polygon": [[857.5200000000001, 922.6949999999999], [1454.608, 922.6949999999999], [1454.608, 967.595], [857.5200000000001, 967.595]], "confidence": 0.982501760871812, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 23, "html": "<h2>★ वर्तमान पर्यायको हो अर्थ कहने सम्बन्धो शंका</h2>", "skipped": false, "error": false, "bbox": [857.5200000000001, 922.6949999999999, 1454.608, 967.595]}, {"polygon": [[1260.872, 967.595], [1491.1319999999998, 967.595], [1491.1319999999998, 1008.005], [1260.872, 1008.005]], "confidence": 0.9825017608