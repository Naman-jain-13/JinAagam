27.5749999999999]], "confidence": 0.966467491131552, "label": "Text", "raw_label": "Text", "reading_order": 5, "html": "<p><b>Sahu Shanti Prasad Jain</b></p>", "skipped": false, "error": false, "bbox": [557.3879999999999, 484.92, 1017.908, 527.5749999999999]}, {"polygon": [[333.47999999999996, 532.0649999999999], [1248.1680000000001, 532.0649999999999], [1248.1680000000001, 720.645], [333.47999999999996, 720.645]], "confidence": 0.966467491131552, "label": "Text", "raw_label": "Text", "reading_order": 6, "html": "<p>In memory of his illustrious mother Smt. Moortidevi<br/>and<br/>promoted by his benevolent wife<br/><b>Smt. Rama Jain</b></p>", "skipped": false, "error": false, "bbox": [333.47999999999996, 532.0649999999999, 1248.1680000000001, 720.645]}, {"polygon": [[281.07599999999996, 821.67], [1297.396, 821.67], [1297.396, 1230.26], [281.07599999999996, 1230.26]], "confidence": 0.966467491131552, "label": "Text", "raw_label": "Text", "reading_order": 7, "html": "<p>In this Granthamala critically edited Jain agamic, philosophical, puranic, literary, historical and other original texts in Prakrit, Sanskrit, Apabhramsha, Hindi, Kannada, Tamil etc. are being published in the original form with their translations in modern languages.<br/>Catalogues of Jain bhandaras, inscriptions, studies on art and architecture by competent scholars and popular Jain literature are also being published</p>", "skipped": false, "error": false, "bbox": [281.07599999999996, 821.67, 1297.396, 1230.26]}, {"polygon": [[778.12, 1322.3049999999998], [801.94, 1322.3049999999998], [801.94, 1349.245], [778.12, 1349.245]], "confidence": 0.966467491131552, "label": "Picture", "raw_label": "Image", "reading_order": 8, "html": "", "skipped": true, "error": false, "bbox": [778.12, 1322.3049999999998, 801.94, 1349.245]}, {"polygon": [[503.396, 1409.86], [1071.9, 1409.86], [1071.9, 1497.4150000000002], [503.396, 1497.4150000000002]], "confidence": 0.966467491131552, "label": "Text", "raw_label": "Text", 