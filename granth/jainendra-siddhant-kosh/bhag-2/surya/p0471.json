{"blocks": [{"polygon": [[76.224, 74.08500000000001], [125.452, 74.08500000000001], [125.452, 118.985], [76.224, 118.985]], "confidence": 0.980869731952398, "label": "PageHeader", "raw_label": "Page-Header", "reading_order": 0, "html": "द्वैत", "skipped": false, "error": false, "bbox": [76.224, 74.08500000000001, 125.452, 118.985]}, {"polygon": [[752.712, 74.08500000000001], [819.408, 74.08500000000001], [819.408, 114.49499999999999], [752.712, 114.49499999999999]], "confidence": 0.980869731952398, "label": "PageHeader", "raw_label": "Page-Header", "reading_order": 1, "html": "४६३", "skipped": false, "error": false, "bbox": [752.712, 74.08500000000001, 819.408, 114.49499999999999]}, {"polygon": [[1410.144, 74.08500000000001], [1481.604, 74.08500000000001], [1481.604, 114.49499999999999], [1410.144, 114.49499999999999]], "confidence": 0.980869731952398, "label": "PageHeader", "raw_label": "Page-Header", "reading_order": 2, "html": "घनुष", "skipped": false, "error": false, "bbox": [1410.144, 74.08500000000001, 1481.604, 114.49499999999999]}, {"polygon": [[109.572, 143.68], [771.768, 143.68], [771.768, 260.42], [109.572, 260.42]], "confidence": 0.980869731952398, "label": "Text", "raw_label": "Text", "reading_order": 3, "html": "<p>ही एक भेद है। उसे द्वेष कहते हैं। २. असह्यजनोंमें तथा असह्य-पदार्थोंके समूहमें बैरके परिणाम रखना द्वेष कहलाता है। और भी दे० राग/२।</p>", "skipped": false, "error": false, "bbox": [109.572, 143.68, 771.768, 260.42]}, {"polygon": [[117.512, 285.115], [292.192, 285.115], [292.192, 327.77], [117.512, 327.77]], "confidence": 0.980869731952398, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 4, "html": "<h3>२. द्वेषके भेद</h3>", "skipped": false, "error": false, "bbox": [117.512, 285.115, 292.192, 327.77]}, {"polygon": [[82.576, 338.995], [767.004, 338.995], [767.004, 561.25], [82.576, 561.25]], "confidence": 0.980869731952398, "label": "Text", "raw_label": "Text", "reading_order": 5, "html": "<p>क.पा.१/१-१४/चूर्ण सूत्र/§२२६/२७७ दोसो णिन्निखवियव्वो णामदोसो दृवदोसो दव्वदोसो भावदोसो चेदि। = नामदोष, स्थापनादोष, द्रव्यदोष और भावदोष इस प्रकार दोष (द्वेष) का निक्षेप करना चाहिए। (इनके उत्तर भेदोंके लिए दे० निक्षेप)।<br/>दे० कषाय/४ कोध, मान, अरति, शोक, भय, व जुगुप्सा ये छह कषाय द्वेषरूप हैं।</p>", "skipped": false, "error": false, "bbox": [82.576, 338.995, 767.004, 561.25]}, {"polygon": [[114.33599999999998, 597.1700000000001], [398.588, 597.1700000000001], [398.588, 642.0699999999999], [114.33599999999998, 642.0699999999999]], "confidence": 0.980869731952398, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 6, "html": "<h3>३. द्वेषके भेदोंके लक्षण</h3>", "skipped": false, "error": false, "bbox": [114.33599999999998, 597.1700000000001, 398.588, 642.0699999999999]}, {"polygon": [[82.576, 651.05], [765.4159999999999, 651.05], [765.4159999999999, 1201.075], [82.576, 1201.075]], "confidence": 0.980869731952398, "label": "Text", "raw_label": "Text", "reading_order": 7, "html": "<p>क.पा.१/१-१४/चूर्ण सूत्र/§२३=-२३३/२८०-२८३ णामदृवणा-आगमदव्व-णोआगमदव्वजाणुगसरीर-मविय-णिवलेवा सुगमा त्ति कट्टु तैसिम-स्थममणिय तव्वदिरित्त - णोआगमदव्वदोससरूपपरूवणट्ठमुत्तर-त्तं भणदि। —णोआगमदव्वदोसो णाम अं दव्वं जेण उवघादेण उवभोर्ग ण एदि तस्स दव्वस्स सो उवघादे दोसो णाम।—तं जहा—सादियए अग्गिदद्व' बा मूसयभश्चिखयं वा एवमादि। = नामनिक्षेप, स्थापनानिक्षेप, आगमद्रव्यनिक्षेप और नोआगम-द्रव्यनिक्षेपके दो भेद ज्ञायकशरोर और भावी ये सब निक्षेप सुगम है ( दे० निक्षेप)। ऐसा समम्कर इन सब निक्षेपोंके स्वरूपका कथन नहीं करके तद्वयतिरिक्त नोआगमद्रव्यदोषके स्वरूपका कथन करनेके लिए आगेका सूत्र कहते हैं—जो द्रव्य इस उपघातके निमित्तसे उपभोगको नहीं प्राप्त होता है वह उपघात उस द्रव्यका दोष है। इसे ही तद्वयतिरिक्तनोआगमद्रव्यदोष समम्फना चाहिए। वह उपघात दोष कौन-सा है ! साडीका अग्निसे जल जाना अथवा चूहोंके द्वारा खाया-जाना तथा इसी प्रकार और दूसरे भी दोष है।</p>", "skipped": false, "error": false, "bbox": [82.576, 651.05, 765.4159999999999, 1201.075]}, {"polygon": [[104.808, 1212.3000000000002], [587.56, 1212.3000000000002], [587.56, 1257.2], [104.808, 1257.2]], "confidence": 0.980869731952398, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 8, "html": "<h3>* द्वेष सम्बन्धी अन्य विषय—दे० राग।</h3>", "skipped": false, "error": false, "bbox": [104.808, 1212.3000000000002, 587.56, 1257.2]}, {"polygon": [[104.808, 1268.425], [760.6519999999999, 1268.425], [760.6519999999999, 1347.0], [104.808, 1347.0]], "confidence": 0.980869731952398, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 9, "html": "<h3>* द्वेषका स्वभाव विभावपना तथा सहेतुक अहेतुकपना<br/>—दे० विभाव/२,५।</h3>", "skipped": false, "error": false, "bbox": [104.808, 1268.425, 760.6519999999999, 1347.0]}, {"polygon": [[82.576, 1362.715], [760.6519999999999, 1362.715], [760.6519999999999, 1519.865], [82.576, 1519.865]], "confidence": 0.980869731952398, "label": "Text", "raw_label": "Text", "reading_order": 10, "html": "<p><b>द्वैत—</b>(पं.वि/४/३३) बन्धमोक्षौ रतिद्वेषौ कर्मात्मानौ शुभाशुभौ। इति द्वैताभिता बुद्धिरसिद्धिरभिधीयते। = बन्ध और मोक्ष, राग और द्वेष, कर्म और आत्मा, तथा शुभ और अशुभ, इस प्रकार-को बुद्धि द्वैतके आभ्यसे होती है।</p>", "skipped": false, "error": false, "bbox": [82.576, 1362.715, 760.6519999999999, 1519.865]}, {"polygon": [[104.808, 1522.1100000000001], [676.4879999999999, 1522.1100000000001], [676.4879999999999, 1567.01], [104.808, 1567.01]], "confidence": 0.980869731952398, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 11, "html": "<h3>* द्वैत व अद्वैतवादका विधि निषेध व समन्वय</h3>", "skipped": false, "error": false, "bbox": [104.808, 1522.1100000000001, 676.4879999999999, 1567.01]}, {"polygon": [[603.44, 1571.5], [757.476, 1571.5], [757.476, 1609.665], [603.44, 1609.665]], "confidence": 0.980869731952398, "label": "Text", "raw_label": "Text", "reading_order": 12, "html": "<p>—दे० द्रव्य/४।</p>", "skipped": false, "error": false, "bbox": [603.44, 1571.5, 757.476, 1609.665]}, {"polygon": [[74.636, 1618.645], [433.52400000000006, 1618.645], [433.52400000000006, 1670.28], [74.636, 1670.28]], "confidence": 0.980869731952398, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 13, "html": "<h3>द्वैताद्वैतवाद—दे० वेदान्त/३,५,६</h3>", "skipped": false, "error": false, "bbox": [74.636, 1618.645, 433.52400000000006, 1670.28]}, {"polygon": [[82.576, 1674.77], [760.6519999999999, 1674.77], [760.6519999999999, 2081.1150000000002], [82.576, 2081.1150000000002]], "confidence": 0.980869731952398, "label": "Text", "raw_label": "Text", "reading_order": 14, "html": "<p><b>द्वैपायन—</b>(ह.पु./६१/श्लो.) रोहिणीका भाई बलदेवका मामा भग-वान्से यह सुनकर कि उसके द्वारा द्वारिका जलेमी; तो बह विरक्त होकर मुनि हो गया (२८)। कठिन तपम्वरणके द्वारा तैजस ऋद्धि प्राप्त हो गयी, तब भ्रान्तिवश बारह वर्षसे कुछ पहले ही द्वारिका देखनेके लिए आये (४४)। मदिरा पीनेके द्वारा उन्मत्त हुए कृष्णके भाइयोंने उसको अपशम्ब कहे तथा उसपर पत्थर मारे (५५)। जिसके कारण उसे कोध आ गया और तैजस समुद्रघात द्वारा द्वारिकाको भरम कर दिया। बडी अनुनय और विनय करनेके पश्चात् केवल कृष्ण व बलदेव दो ही बचने पाये (५६-८६)। यह भावि-कालकी चौबीसीमें स्वयम्भू नामके १९वें तीर्थंकर होंगे।<br/>—दे० तीर्थंकर/५।</p>", "skipped": false, "error": false, "bbox": [82.576, 1674.77, 760.6519999999999, 2081.1150000000002]}, {"polygon": [[846.404, 143.68], [1241.816, 143.68], [1241.816, 193.07], [846.404, 193.07]], "confidence": 0.980869731952398, "label": "SectionHeader", "raw_label": "Section-Header", "reading_order": 15, "html": "<h3>२. द्वैपायनके उत्तरमव सम्बन्धी</h3>", "skipped": false, "error": false, "bbox": [846.404, 143.68, 1241.816, 193.07]}, {"polygon": [[816.232, 204.295], [1513.364, 204.295], [1513.364, 388.385], [816.232, 388.385]], "confidence": 0.980869731952398, "label": "Text", "raw_label": "Text", "reading_order": 16, "html": "<p>ह.पु./६१/६९ मृत्वा क्रोधाग्निर्दर्शतप-सारधनश्च स'। त्रभूवाग्नि-कुमाराख्यो मिथ्यादृग्भवनामर'।६९। = क्रोधरूपी अग्निके द्वारा जिनका तपरूप श्रेष्ठ धन भरम हो चुका या ऐसे द्वैपायन मुनि मर-कर अग्निकुमार नामक मिथ्यादृष्टि भवनवासी देव हुए। (ध.