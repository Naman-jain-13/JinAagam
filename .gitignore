# ---------------------------------------------------------------- heavy, regenerable
# Rendered scan pages (300 dpi PNGs). ~1.65 GB. Regenerate from the source PDF with
# pymupdf whenever a text is being worked on — see each work folder's progress.md.
**/img/
**/pages/

# npm packages for the docx builders — `npm install` restores them
node_modules/

# Python bytecode
__pycache__/
*.py[cod]

# ---------------------------------------------------------------- documents
# Source scans stay local: they are large and already published by the libraries
# that digitised them (jainelibrary.org, Veer Seva Mandir and others).
# Finished commentaries are attached to GitHub Releases instead of the git history,
# so a clone stays small and the history is not rewritten on every rebuild.
*.pdf
*.docx
*.doc

# Word lock files and pre-edit backups
~$*
*.bak
*.bak.*
*.pre-honorific.*

# Scratch crops and stray build logs kept out of the way
_scratch/

# ---------------------------------------------------------------- build noise
*.log
finalize.log*
build_log.txt
*.tmp

# Generated single-file edition of the Kosh (5 MB, rebuilt by build_online.py).
# The site published from this repo uses encyclopedia/index.html + encyclopedia/data/.
encyclopedia/online.html
encyclopedia/_check.js

# Scratch crops from scan-checking (regenerable from the source PDF; the A/B
# test's actual results — the .md and .txt files — stay tracked).
**/tmp_check/
**/_model_test/crops/
**/_model_test/pdfcheck/

# ग्रन्थ-सेटअप के समय बनी पृष्ठ-अङ्क पट्टियाँ (pagemap.json में नतीजा सुरक्षित है)
**/_pagemap/*.png

# बड़े संग्रह (backup archives) — git में कभी नहीं
*.zip
*.7z
*.rar
*.tar
*.tar.gz
granth/*/_citations/corpus/

# एजेंट अपने काम के बीच अस्थायी फ़ाइलें छोड़ जाते हैं — वे ग्रन्थ का अंग नहीं
granth/*/out*.txt
granth/*/pyout.txt
granth/*/*_tmp.txt
granth/*/range_dump.txt
granth/*/idx_slice.json
granth/*/addenda/out*.txt

# addenda/ और parts/ में केवल .md रहती हैं — वहाँ कोई भी .txt एजेंट की
# अस्थायी फ़ाइल ही है। पहले यहाँ "addenda/out*.txt" लिखा था, जो नाम-भर से
# बँधा था और "wc_out.txt" उसमें से निकल गया। अब पूरी निर्देशिका पर।
granth/*/addenda/*.txt
granth/*/parts/*.txt
granth/*/addenda/*.json

# स्कैन जाँचते समय काटे गए टुकड़े — मूल PDF से दोबारा बन जाते हैं, और भारी होते हैं
# (प्रमेयकमल में अकेले 65 MB, 202 फ़ाइलें git में चली गई थीं)। निर्णय जो इनसे निकले
# वे _recheck/ की रिपोर्टों में लिखे रहते हैं; चित्र रखने की ज़रूरत नहीं।
granth/*/crops/

# सिद्धिविनिश्चय के रेंडर किए पन्ने — मूल PDF से दोबारा बन जाते हैं
granth/siddhi-vinishchaya-*/img/

# Cloudflare local state
.wrangler/

# rendered/scratch page images are never committed
**/img_low/
**/scratch/
